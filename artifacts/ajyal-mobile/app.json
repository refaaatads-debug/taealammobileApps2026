{
  "expo": {
    "name": "ajyalalmaerifa",
    "slug": "ajyal-mobile",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/images/ajyal-icon.png",
    "scheme": "ajyalalmaerifa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajyalalmaerifa.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج التطبيق إلى الميكروفون لإجراء الجلسات التعليمية.",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق الصور فقط عند اختيار صورة لإرسالها كحل أو مرفق."
      },
      "bitcode": false
    },
    "android": {
      "package": "com.ajyalalmaerifa.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 193,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/ajyal-icon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/4f6614d5-2a55-410c-8c71-f9430594fbfd",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "updatePolicy": {
        "mandatory": false,
        "minimumSupportedVersion": "1.0.0"
      },
      "eas": {
        "projectId": "4f6614d5-2a55-410c-8c71-f9430594fbfd"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/withIncomingCallNative",
      "./plugins/withAjyalNativeCalls",
      "./plugins/withGoogleMapsKeys",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم تطبيق أجيال المعرفة موقعك عند طلبك لتحديد موقعك الحالي على الخريطة."
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-notifications",
        {
          "color": "#2E9E79",
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/audio/incoming_call.wav",
            "./assets/audio/message_notification.wav",
            "./assets/audio/session_notification.wav",
            "./assets/audio/approval_notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق الصور فقط عند اختيار صورة لإرسالها كحل أو مرفق.",
          "cameraPermission": "يستخدم التطبيق الكاميرا فقط عند تصوير واجب أو سؤال لإرساله. الجلسات صوت ومشاركة شاشة بدون كاميرا."
        }
      ],
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F9",
          "image": "./assets/images/ajyal-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "buildArchs": [
              "arm64-v8a"
            ],
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libaosl.so"
              ],
              "exclude": [
                "**/libagora_lip_sync_extension.so",
                "**/libagora_clear_vision_extension.so",
                "**/libagora_segmentation_extension.so",
                "**/libagora_face_capture_extension.so",
                "**/libagora_face_detection_extension.so",
                "**/libagora_audio_beauty_extension.so",
                "**/libagora_content_inspect_extension.so",
                "**/libagora_video_quality_analyzer_extension.so",
                "**/libagora_video_av1_encoder_extension.so"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ajyalalmaerifa"
  }
}
