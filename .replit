modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "dbus", "atk", "gtk3", "cairo", "pango", "gdk-pixbuf", "mesa", "libdrm", "libgbm"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_SUPABASE_URL = "https://ajyalalmaerifa.com"

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22030
externalPort = 80

